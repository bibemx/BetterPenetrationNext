<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion><Version>1.0.9</Version><Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Authors>BetterPenetration contributors; Next contributors</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PathMap>$(MSBuildThisFileDirectory)=/_/bpn/</PathMap>
  </PropertyGroup>
</Project>
